# 留空时使用代码默认值；这里不填写个人资料或真实凭据。
# SQLite 数据库位置，默认 sqlite:///data/jobpilot.db。
DATABASE_URL=
# 日志详细程度，默认 INFO；排查问题时可设为 DEBUG。
LOG_LEVEL=
# 候选人 JSON 文件位置，默认使用 fixtures 中的虚构示例。
CANDIDATE_PROFILE_PATH=
# 模拟岗位 JSON 目录，默认 fixtures/jobs。
MOCK_JOBS_PATH=
# 真实模型使用支持 json_schema 的 OpenAI 兼容接口；密钥只保存在本机 .env。
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# 每百万 Token 单价，使用同一种计价货币；不知道时留空，成本显示为未知。
LLM_INPUT_PRICE_PER_MILLION=
LLM_OUTPUT_PRICE_PER_MILLION=

# 新 Agent 数据后端；留空时工作流 CLI 保留 Phase 5 的 SQLite 文件。
# 服务端使用示例：postgresql://jobpilot:本机设置的密码@localhost:5432/jobpilot
AGENT_DATABASE_URL=

# 本地 Dashboard/API 令牌；留空则首次启动写入 data/agent/api-token.txt。
JOBPILOT_API_TOKEN=
