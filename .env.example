# 留空时使用代码默认值；这里不填写个人资料或真实凭据。
# SQLite 数据库位置，默认 sqlite:///data/jobpilot.db。
DATABASE_URL=
# 日志详细程度，默认 INFO；排查问题时可设为 DEBUG。
LOG_LEVEL=
# 候选人 JSON 文件位置，默认使用 fixtures 中的虚构示例。
CANDIDATE_PROFILE_PATH=
# 模拟岗位 JSON 目录，默认 fixtures/jobs。
MOCK_JOBS_PATH=
# 真实模型使用支持 json_schema 的 OpenAI 兼容接口；密钥只保存在本机 .env。
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
